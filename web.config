<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="src/index.js" verb="*" modules="iisnode" resourceType="Unspecified" />
    </handlers>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <iisnode node_env="development" loggingEnabled="true" devErrorsEnabled="true" />
        <rewrite>
            <rules>
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:6007/{R:1}" />
                </rule>
            </rules>
        </rewrite>
  </system.webServer>
</configuration>
